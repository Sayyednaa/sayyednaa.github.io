---
import RootLayout from '../layouts/RootLayout.astro';
---

<RootLayout title="404 - Page Not Found | Sayyed Nawab Abdul Ali">
  <main class="min-h-[80vh] flex items-center justify-center px-6">
    <div class="max-w-md text-center rounded-3xl backdrop-blur-glass bg-surface-dark border border-glass-border-dark p-10 shadow-glass">
      <div class="text-7xl font-extrabold text-accent-primary font-mono mb-4">404</div>
      <h1 class="text-2xl font-bold text-white mb-2">Page Displaced in Orbit</h1>
      <p class="text-sm text-slate-400 mb-8">
        The coordinate you navigated to doesn't exist in this quadrant.
      </p>
      <a
        href="/"
        class="inline-block px-6 py-3 rounded-xl text-xs font-bold uppercase tracking-wider bg-accent-primary text-white shadow-glow hover:bg-accent-primary/90 transition-all"
      >
        Return to Home
      </a>
    </div>
  </main>
</RootLayout>
