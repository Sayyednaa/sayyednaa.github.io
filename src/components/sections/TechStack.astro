---
import { Reveal } from '../motion/Reveal';
import { TECH_STACK } from '../../lib/constants';
---

<section id="tech-stack" class="py-24 px-6 relative">
  <div class="max-w-6xl mx-auto">
    <Reveal client:visible>
      <div class="text-center mb-16">
        <span class="text-xs font-mono uppercase tracking-widest text-accent-primary">Ecosystem</span>
        <h2 class="text-3xl md:text-5xl font-extrabold text-white mt-2">Languages & Frameworks</h2>
        <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto mt-3">
          Technologies, frameworks, databases, and architectures I leverage to build production-grade systems.
        </p>
      </div>
    </Reveal>

    <Reveal client:visible delay={0.2}>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {TECH_STACK.map((tech) => (
          <div class="tech-item group relative p-4 rounded-2xl backdrop-blur-glass bg-surface-dark border border-glass-border-dark hover:border-accent-primary/50 hover:bg-slate-900/90 transition-all duration-300 flex flex-col items-center justify-center text-center gap-3 shadow-glass hover:-translate-y-1">
            
            <!-- Tech Icon Wrapper with Glow on Hover -->
            <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center p-2.5 group-hover:scale-110 group-hover:bg-white/10 transition-transform duration-300">
              
              {tech.icon === 'python' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <path d="M11.9 2C6.9 2 7.2 4.2 7.2 4.2l.01 2.3h4.8v.7H5.2S2 6.8 2 11.9c0 5 2.8 4.9 2.8 4.9h1.7v-2.4s-.1-2.8 2.8-2.8h4.8s2.7.05 2.7-2.6V4.7S17 2 11.9 2zm-2.2 1.5c.5 0 .9.4.9.9s-.4.9-.9.9-.9-.4-.9-.9.4-.9.9-.9z" fill="#3776AB"/>
                  <path d="M12.1 22c5 0 4.7-2.2 4.7-2.2l-.01-2.3H12v-.7h6.8s3.2.4 3.2-4.7c0-5-2.8-4.9-2.8-4.9h-1.7v2.4s.1 2.8-2.8 2.8H9.9s-2.7-.05-2.7 2.6v4.3S7 22 12.1 22zm2.2-1.5c-.5 0-.9-.4-.9-.9s.4-.9.9-.9.9.4.9.9-.4.9-.9.9z" fill="#FFD43B"/>
                </svg>
              )}

              {tech.icon === 'javascript' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <rect width="24" height="24" rx="4" fill="#F7DF1E"/>
                  <path d="M7 17.5c.8.5 1.7.8 2.6.8 1.4 0 2.3-.7 2.3-1.8 0-1.2-.8-1.7-2.1-2.3l-.7-.3c-1.8-.8-3-1.8-3-3.7 0-2 1.6-3.5 4.1-3.5 1.1 0 2.1.3 3 .8l-.7 2c-.7-.4-1.4-.7-2.3-.7-1.1 0-1.8.6-1.8 1.4 0 1 .7 1.4 2 2l.7.3c2.1.9 3.2 1.9 3.2 4 0 2.3-1.8 3.8-4.6 3.8-1.3 0-2.6-.4-3.5-.9l.9-2.1z" fill="#000"/>
                  <path d="M17.5 7v7.8c0 2-.9 3.1-2.6 3.7l-.8-1.9c.9-.4 1.3-.9 1.3-1.8V7h2.1z" fill="#000"/>
                </svg>
              )}

              {tech.icon === 'typescript' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <rect width="24" height="24" rx="4" fill="#3178C6"/>
                  <path d="M4 10h8v2H9v7H7v-7H4v-2zm9 7.4c.8.5 1.7.8 2.7.8 1.5 0 2.4-.7 2.4-1.9 0-1.2-.8-1.8-2.2-2.4l-.7-.3c-1.9-.8-3.1-1.9-3.1-3.9 0-2.1 1.7-3.7 4.3-3.7 1.2 0 2.2.3 3.1.8l-.7 2.1c-.7-.4-1.5-.7-2.4-.7-1.2 0-1.9.6-1.9 1.5 0 1 .7 1.5 2.1 2.1l.7.3c2.2.9 3.4 2 3.4 4.2 0 2.4-1.9 4-4.8 4-1.4 0-2.8-.4-3.7-1l.8-2z" fill="#FFF"/>
                </svg>
              )}

              {tech.icon === 'java' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <path d="M8.8 18.5s-.8.5 1.2.7c2.4.2 3.8.2 6.5-.2 0 0 .9.6 1.9.2-2.4 1.1-7.7 1-9.6-.7zm-.9-2.2c2 .2 3.8.2 6.8-.2 0 0 .7.4 1.4.2-1.9.8-6.1.8-8.2 0zm5.8-6.9c.6.7-.4 1.5-.4 1.5s1.7-.9.9-2.1c-.8-1.1-1.5-1.7 2-3.8-3.7.8-3.6 3.1-2.5 4.4zm3.9 6.2s1.1.8-1.2 1.4c-4.4 1.2-10 .7-10.7-.7 0 0-.6.7 1.1 1.1 5.4 1.2 12.3.4 10.8-1.8z" fill="#E76F00"/>
                  <path d="M17.4 14.5c.8-1.3-.9-2.6-.9-2.6s1.6.8.8 2c-.9 1.4-1.6 2.1.2 3.6-2.1-.6-1.5-1.9-.1-3zm-6-9.7C9.8 6.4 8.7 8.3 8.7 8.3s.7-.5 1.5-.9c1.6-.7 2.8-.6 4.3.4 0 0 .5-.6-1.1-1.3-1.6-.6-1.6-1.3-2-1.7z" fill="#5382A1"/>
                </svg>
              )}

              {tech.icon === 'html' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <path d="M4 3l1.6 18 6.4 1.8 6.4-1.8L20 3H4zm13.6 4.6l-.2 2.3h-7.6l.2 2.3h7.2l-.6 6.3-4.6 1.3-4.6-1.3-.3-3.5h2.3l.1 1.8 2.5.7 2.5-.7.3-3.2H6.9l-.6-7h11.3z" fill="#E34F26"/>
                </svg>
              )}

              {tech.icon === 'react' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <ellipse cx="12" cy="12" rx="10" ry="4" stroke="#61DAFB" stroke-width="1.5" transform="rotate(0 12 12)"/>
                  <ellipse cx="12" cy="12" rx="10" ry="4" stroke="#61DAFB" stroke-width="1.5" transform="rotate(60 12 12)"/>
                  <ellipse cx="12" cy="12" rx="10" ry="4" stroke="#61DAFB" stroke-width="1.5" transform="rotate(120 12 12)"/>
                  <circle cx="12" cy="12" r="1.8" fill="#61DAFB"/>
                </svg>
              )}

              {tech.icon === 'reactnative' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <rect x="5" y="2" width="14" height="20" rx="3" stroke="#61DAFB" stroke-width="1.5" fill="none"/>
                  <circle cx="12" cy="18" r="1" fill="#61DAFB"/>
                  <ellipse cx="12" cy="9.5" rx="5" ry="2" stroke="#61DAFB" stroke-width="1" transform="rotate(30 12 9.5)"/>
                  <ellipse cx="12" cy="9.5" rx="5" ry="2" stroke="#61DAFB" stroke-width="1" transform="rotate(-30 12 9.5)"/>
                  <circle cx="12" cy="9.5" r="0.8" fill="#61DAFB"/>
                </svg>
              )}

              {tech.icon === 'django' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <rect width="24" height="24" rx="4" fill="#092E20"/>
                  <path d="M12.5 5v7.2c-.7.1-1.3.1-1.8.1-2.5 0-3.9-1.2-3.9-3.6 0-2.3 1.5-3.8 3.8-3.8.7 0 1.3.1 1.9.1zm-1.8 5.6c.6 0 1.2-.1 1.8-.2V6.8c-.5-.1-1-.1-1.4-.1-1.3 0-2.1.8-2.1 2 0 1.3.7 1.9 1.7 1.9zm4.2-5.6h1.9v14h-1.9V5z" fill="#44B78B"/>
                </svg>
              )}

              {tech.icon === 'postgresql' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 16.5h-2v-1.5h2v1.5zm3.5-3.5H7.5c-.8 0-1.5-.7-1.5-1.5v-4c0-2.2 1.8-4 4-4h4c2.2 0 4 1.8 4 4v4c0 .8-.7 1.5-1.5 1.5z" fill="#336791"/>
                  <circle cx="10" cy="9.5" r="1" fill="#FFF"/>
                  <circle cx="14" cy="9.5" r="1" fill="#FFF"/>
                </svg>
              )}

              {tech.icon === 'restapi' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="#00f2fe" stroke-width="1.8">
                  <rect x="2" y="5" width="20" height="14" rx="3" stroke="#00f2fe"/>
                  <path d="M6 12h3M12 9v6M15 12h3" stroke-linecap="round"/>
                  <circle cx="6" cy="12" r="1" fill="#00f2fe"/>
                  <circle cx="18" cy="12" r="1" fill="#00f2fe"/>
                </svg>
              )}

              {tech.icon === 'supabase' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <path d="M13.2 21.8c-.8.9-2.2.3-2.1-.9l.7-8.9H3.6c-1 0-1.6-1.1-1-1.9L11.8 1.2c.8-.9 2.2-.3 2.1.9l-.7 8.9h8.2c1 0 1.6 1.1 1 1.9l-9.2 8.9z" fill="#3ECF8E"/>
                </svg>
              )}

              {tech.icon === 'android' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <path d="M6 10v7h2v-7H6zm10 0v7h2v-7h-2zM8.5 7.5c0-.6.4-1 1-1s1 .4 1 1-.4 1-1 1-1-.4-1-1zm5 0c0-.6.4-1 1-1s1 .4 1 1-.4 1-1 1-1-.4-1-1z" fill="#3DDC84"/>
                  <path d="M7 4.5l-1.5-2-.8.6 1.4 1.9C4.8 6 4 7.6 4 9.5h16c0-1.9-.8-3.5-2.1-4.5L19.3 3l-.8-.6L17 4.5C15.6 3.9 14 3.5 12 3.5s-3.6.4-5 1zM7 10.5v8c0 .8.7 1.5 1.5 1.5h1v3h2v-3h1v3h2v-3h1c.8 0 1.5-.7 1.5-1.5v-8H7z" fill="#3DDC84"/>
                </svg>
              )}

              {tech.icon === 'tailwind' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <path d="M12 6c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.9.2 1.6.9 2.3 1.6 1.2 1.2 2.6 2.6 5.5 2.6 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.9-.2-1.6-.9-2.3-1.6C16.3 7.4 14.9 6 12 6zM6 13.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.9.2 1.6.9 2.3 1.6 1.2 1.2 2.6 2.6 5.5 2.6 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.9-.2-1.6-.9-2.3-1.6C10.3 14.6 8.9 13.2 6 13.2z" fill="#38BDF8"/>
                </svg>
              )}

              {tech.icon === 'linux' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <path d="M12 2c-3 0-5 2.5-5 5.5 0 1.8.8 3.5 1.8 4.7-.2.6-.8 1.8-1.8 2.8-1.2 1.2-2 1.8-2 2.8 0 1.8 2.5 3.2 7 3.2s7-1.4 7-3.2c0-1-.8-1.6-2-2.8-1-1-1.6-2.2-1.8-2.8 1-1.2 1.8-2.9 1.8-4.7C17 4.5 15 2 12 2zm-1.5 5c.4 0 .7.3.7.7s-.3.7-.7.7-.7-.3-.7-.7.3-.7.7-.7zm3 0c.4 0 .7.3.7.7s-.3.7-.7.7-.7-.3-.7-.7.3-.7.7-.7zm-1.5 2.2c1.2 0 1.8.6 1.8.8s-.6.8-1.8.8-1.8-.6-1.8-.8.6-.8 1.8-.8z" fill="#FCC624"/>
                </svg>
              )}

              {tech.icon === 'git' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none">
                  <path d="M21.7 10.7l-8.4-8.4c-.6-.6-1.6-.6-2.2 0l-1.8 1.8 2.3 2.3c.6-.2 1.3-.1 1.8.4.5.5.6 1.2.4 1.8l2.2 2.2c.6-.2 1.3-.1 1.8.4.7.7.7 1.9 0 2.6-.7.7-1.9.7-2.6 0-.6-.6-.7-1.4-.3-2.1l-2.1-2.1v4.8c.3.2.6.5.7.9.5.9.1 2-1 2.3-1 .4-2.1 0-2.5-.9-.4-1 0-2.1.9-2.5.3-.1.6-.1.9 0v-4.9c-.3-.1-.6-.1-.9 0-.9.4-2 0-2.5-.9-.4-1 0-2.1.9-2.5.5-.2 1-.1 1.4.2L6.8 3.5 2.3 8c-.6.6-.6 1.6 0 2.2l8.4 8.4c.6.6 1.6.6 2.2 0l8.8-8.8c.6-.5.6-1.5 0-2.1z" fill="#F05032"/>
                </svg>
              )}

            </div>

            <!-- Tech Details -->
            <div class="flex flex-col items-center">
              <span class="text-sm font-bold text-white group-hover:text-accent-primary transition-colors">
                {tech.name}
              </span>
              <span class="text-[10px] uppercase font-mono tracking-wider text-slate-500 mt-0.5">
                {tech.category}
              </span>
            </div>

          </div>
        ))}
      </div>
    </Reveal>
  </div>
</section>
