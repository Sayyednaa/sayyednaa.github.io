---
import { SITE_METADATA } from '../../lib/constants';
import { Reveal } from '../motion/Reveal';
---

<section id="home" class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-20 px-6 overflow-hidden">
  <!-- Subtle ambient glow spheres in background -->
  <div class="absolute top-1/4 left-10 w-96 h-96 bg-accent-primary/15 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 right-10 w-96 h-96 bg-cyan-400/10 rounded-full blur-[120px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
    
    <!-- Left Column: Hero Greeting & Content (7 Cols on LG) -->
    <div class="lg:col-span-7 flex flex-col items-start text-left">
      
      <!-- Greeting & Status Badge -->
      <Reveal client:visible delay={0.1}>
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full backdrop-blur-glass bg-white/5 border border-glass-border-dark text-slate-200 text-xs font-semibold uppercase tracking-wider mb-6 shadow-sm">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-slate-300">👋 Welcome! Available for projects & roles</span>
        </div>
      </Reveal>

      <!-- Main Headline -->
      <Reveal client:visible delay={0.2}>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white mb-6 leading-[1.08]">
          Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-primary via-rose-400 to-cyan-400">Sayyed</span>. <br />
          Crafting Digital <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-accent-primary">Experiences.</span>
        </h1>
      </Reveal>

      <!-- Subheadline / Narrative -->
      <Reveal client:visible delay={0.3}>
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mb-8 leading-relaxed">
          {SITE_METADATA.subheadline}
        </p>
      </Reveal>

      <!-- CTAs & Fast Links -->
      <Reveal client:visible delay={0.4}>
        <div class="flex flex-wrap items-center gap-4 mb-8">
          <a
            href="#projects"
            class="px-8 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-accent-primary hover:bg-accent-primary/90 text-white shadow-glow hover:scale-[1.02] transition-all duration-200"
          >
            Explore Projects
          </a>
          <a
            href="#contact"
            class="px-8 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 hover:text-white hover:scale-[1.02] transition-all duration-200"
          >
            Get in Touch
          </a>
        </div>
      </Reveal>

      <!-- Quick Social Ribbon -->
      <Reveal client:visible delay={0.5}>
        <div class="flex items-center gap-4 text-xs text-slate-400 font-mono">
          <span class="text-slate-500 uppercase tracking-wider text-[10px]">Direct:</span>
          <a href={SITE_METADATA.github} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
          <span>•</span>
          <a href={SITE_METADATA.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">LinkedIn</a>
          <span>•</span>
          <a href={SITE_METADATA.x} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">X</a>
          <span>•</span>
          <a href={SITE_METADATA.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-pink-400 transition-colors">Instagram</a>
        </div>
      </Reveal>
    </div>

    <!-- Right Column: Creative Hero Visual Showcase (5 Cols on LG) -->
    <div class="lg:col-span-5 flex justify-center lg:justify-end relative">
      <Reveal client:visible delay={0.25}>
        <div class="relative group max-w-lg lg:max-w-none w-full">
          
          <!-- Outer dynamic backlight glow -->
          <div class="absolute -inset-2 bg-gradient-to-tr from-accent-primary/40 via-cyan-400/30 to-purple-500/40 rounded-3xl blur-2xl opacity-60 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>

          <!-- Glass Frame Showcase Container -->
          <div class="relative rounded-3xl overflow-hidden backdrop-blur-glass bg-slate-900/80 border border-glass-border-dark shadow-2xl transition-all duration-500 group-hover:border-accent-primary/50 group-hover:-translate-y-1">
            
            <!-- Hero Image -->
            <img
              src="/img/hero.png"
              alt="Sayyed Abdul Ali Creative Visual"
              loading="eager"
              fetchpriority="high"
              class="w-full h-auto aspect-[3/2] object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
            />

            <!-- Ambient Gradient Overlay over Image -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-black/20 pointer-events-none"></div>

            <!-- Floating Creative Banner Pill on top of image -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none">
              <div class="px-3 py-1 rounded-full backdrop-blur-md bg-black/60 border border-white/10 text-[11px] font-mono text-slate-200 flex items-center gap-1.5 shadow-lg">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-primary animate-pulse"></span>
                <span>Creative Developer</span>
              </div>
              <div class="w-8 h-8 rounded-full overflow-hidden border border-white/20 p-0.5 bg-black/50">
                <img src="/img/logo.png" alt="Sayyednaa" class="w-full h-full object-cover rounded-full" />
              </div>
            </div>

            <!-- Bottom Floating Greeting & Architecture Badges -->
            <div class="absolute bottom-4 left-4 right-4 flex flex-col gap-2">
              <div class="flex items-center justify-between backdrop-blur-md bg-slate-950/80 border border-white/10 rounded-2xl p-3.5 shadow-xl">
                <div>
                  <p class="text-xs font-bold text-white tracking-wide">"Efforts Never Waste"</p>
                  <p class="text-[10px] font-mono text-slate-400">Python • Full-Stack • React Native</p>
                </div>
                <span class="text-lg">🚀</span>
              </div>
            </div>

          </div>
        </div>
      </Reveal>
    </div>

  </div>
</section>
